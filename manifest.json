{
  "id": "pride",
  "name": "Pride",
  "version": "0.2.2",
  "description": "Pride flags, color patterns, hearts, and LGBTQ+ history for your split-flap display.",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--pride",
  "documentation": "README.md",
  "icon": "flag",
  "category": "art",
  "min_refresh_seconds": 30,
  "fiestaboard_version": ">=2.10.0",
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Pride",
        "default": false
      },
      "mode": {
        "type": "string",
        "title": "Mode",
        "description": "Render mode: 'art' (flags, patterns, hearts, symbols) or 'history' ('On This Day' LGBTQ+ fact).",
        "enum": [
          "art",
          "history"
        ],
        "default": "art"
      },
      "selection": {
        "type": "string",
        "title": "Selection",
        "description": "How to choose the piece in art mode. 'pick' uses the explicit piece setting; the others draw from the pool.",
        "enum": [
          "pick",
          "rotate",
          "daily",
          "random"
        ],
        "default": "rotate"
      },
      "piece": {
        "type": "string",
        "title": "Piece",
        "description": "Which piece to render when selection is 'pick'.",
        "enum": [
          "rainbow",
          "trans",
          "bi",
          "pan",
          "lesbian",
          "ace",
          "nonbinary",
          "progress",
          "intersex",
          "leather",
          "polyamory",
          "genderfluid",
          "ally",
          "rainbow_columns",
          "trans_columns",
          "bi_columns",
          "rainbow_diagonal",
          "rainbow_checker",
          "rainbow_arc",
          "rainbow_sparkle",
          "rainbow_heart",
          "equality"
        ],
        "default": "rainbow"
      },
      "pool": {
        "type": "array",
        "title": "Pool",
        "description": "Categories to draw from for rotate/daily/random. Leave empty to use every piece.",
        "items": {
          "type": "string",
          "enum": [
            "flag",
            "pattern",
            "heart",
            "symbol"
          ]
        },
        "default": []
      },
      "rotate_seconds": {
        "type": "integer",
        "title": "Rotation Interval (seconds)",
        "description": "When selection is 'rotate', how often to switch pieces (minimum 60).",
        "default": 600,
        "minimum": 60
      },
      "message": {
        "type": "string",
        "title": "Custom Message",
        "description": "Optional message laid over the active piece (centered). It is reflowed to the width of whichever board it lands on, so it may occupy more than one row on a narrow board. Leave empty for plain art.",
        "default": "",
        "maxLength": 120
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to recompute the rendered art. Use 30 for the alive Rainbow Sparkle to evolve smoothly.",
        "default": 300,
        "minimum": 30
      }
    },
    "required": []
  },
  "env_vars": [
    {
      "name": "PRIDE_ENABLED",
      "required": false,
      "description": "Enable Pride plugin",
      "default": "false"
    },
    {
      "name": "PRIDE_MODE",
      "required": false,
      "description": "Render mode: art or history",
      "default": "art"
    },
    {
      "name": "PRIDE_SELECTION",
      "required": false,
      "description": "Selection: pick, rotate, daily, random",
      "default": "rotate"
    },
    {
      "name": "PRIDE_PIECE",
      "required": false,
      "description": "Piece id when selection is pick",
      "default": "rainbow"
    },
    {
      "name": "PRIDE_ROTATE_SECONDS",
      "required": false,
      "description": "Rotation interval in seconds",
      "default": "600"
    },
    {
      "name": "PRIDE_MESSAGE",
      "required": false,
      "description": "Custom message overlay",
      "default": ""
    },
    {
      "name": "PRIDE_REFRESH_SECONDS",
      "required": false,
      "description": "Refresh interval in seconds",
      "default": "300"
    }
  ],
  "variables": {
    "groups": {
      "display": {
        "label": "Display"
      },
      "meta": {
        "label": "Metadata"
      },
      "history": {
        "label": "On This Day"
      }
    },
    "simple": {
      "art": {
        "description": "Full-board color art, rendered to the exact dimensions of the board it is displayed on (22x6 Flagship, 15x3 Note, or any note array up to 120x24)",
        "type": "string",
        "max_length": 2903,
        "group": "display",
        "example": "{red}{red}{red}..."
      },
      "piece_id": {
        "description": "Machine id of the active piece (e.g. rainbow, rainbow_heart)",
        "type": "string",
        "max_length": 16,
        "group": "meta",
        "example": "rainbow"
      },
      "piece_name": {
        "description": "Human-readable name of the active piece",
        "type": "string",
        "max_length": 16,
        "group": "meta",
        "example": "Rainbow"
      },
      "piece_category": {
        "description": "Category of the active piece: flag, pattern, heart, symbol, history",
        "type": "string",
        "max_length": 7,
        "group": "meta",
        "example": "flag"
      },
      "tagline": {
        "description": "Short tagline associated with the active piece",
        "type": "string",
        "max_length": 21,
        "group": "meta",
        "example": "Love is love"
      },
      "mode": {
        "description": "Current render mode (art or history)",
        "type": "string",
        "max_length": 7,
        "group": "meta",
        "example": "art"
      },
      "history_year": {
        "description": "Year of today's LGBTQ+ history entry, if any",
        "type": "string",
        "max_length": 4,
        "group": "history",
        "example": "1969"
      },
      "history_text": {
        "description": "Text of today's LGBTQ+ history entry, if any",
        "type": "string",
        "max_length": 114,
        "group": "history",
        "example": "Stonewall Uprising begins in NYC"
      }
    }
  },
  "max_lengths": {
    "art": 2903,
    "piece_id": 16,
    "piece_name": 16,
    "piece_category": 7,
    "tagline": 21,
    "mode": 7,
    "history_year": 4,
    "history_text": 114
  },
